# 이 파일을 복사해서 .streamlit/secrets.toml 로 이름을 바꾸고 값을 채웁니다.
# secrets.toml 은 .gitignore 에 들어 있어서 Git에 올라가지 않습니다. 절대 올리지 마세요.
# 팀원끼리는 카톡 등 저장소 밖에서 따로 주고받습니다.

[firebase]
web_api_key = "Firebase 콘솔 > 프로젝트 설정 > 일반 > 웹 API 키"
storage_bucket = "프로젝트ID.firebasestorage.app"

# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성 → 받은 JSON의 값을 그대로 옮깁니다.
[firebase_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = ""
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""
universe_domain = "googleapis.com"
